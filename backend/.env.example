# docker-compose.yml이 읽는 환경변수. 이 파일을 .env로 복사해 실제 값을 채운다.
# .env는 .gitignore에 등록되어 있어 커밋되지 않는다.

# 32바이트 이상의 임의 문자열. 설정하지 않으면 앱이 기동 시점에 즉시 실패한다.
# 생성 예: openssl rand -hex 32
JWT_SECRET=

# Cloudinary 대시보드 > Product Environment Credentials 의 "API environment variable" 값.
# 형식: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=

# DB 접속 정보 (미설정 시 postgres/postgres)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 마모 진단 엔진: rule-based(기본, 사진을 보지 않는 자리표시자) 또는 ml(하자 탐지 모델 호출)
WEAR_DIAGNOSIS_ENGINE=rule-based

# 하자 탐지 AI 서버(MCM_ai/defect-detection)의 주소. 이 백엔드와 같은 호스트에 있지 않고
# 별도의 "외부 AI 서버"에 떠 있다면 그 서버의 공인 주소(도메인 권장)를 넣는다.
# WEAR_DIAGNOSIS_ENGINE=ml일 때만 실제로 호출된다.
DEFECT_API_URL=http://localhost:8000

# 위 AI 서버가 API_KEY 환경변수로 인증을 요구하도록 설정했다면 여기 동일한 값을 넣는다.
# 인터넷 너머 외부 서버로 붙는 구성이라면 반드시 채울 것 — 비워두면 그 서버가 인증을
# 강제하지 않는 한(즉 그쪽도 API_KEY 미설정) 아무나 호출할 수 있다.
DEFECT_API_KEY=

# 재구매 제안(REPURCHASE) 알림이 뜨는 조건. "오래 소유했고, 최근 진단이 연속으로 D등급"
# 두 가지를 모두 만족해야 한다(Care-First 원칙 — DOMAIN-MODEL.md 4-3절 참고).
#
# ⚠️ 데모: 기본 1095일(3년)이면 방금 만든 데이터로는 절대 뜨지 않는다. 시연하려면
#    아래를 1로 낮추고 `docker compose up -d backend`로 백엔드만 재시작한 뒤,
#    같은 제품에 D등급이 나오는 진단을 두 번 넣으면 된다.
NOTIFICATION_REPURCHASE_OWNERSHIP_DAYS=1095
NOTIFICATION_REPURCHASE_CONSECUTIVE_URGENT=2
